{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://<user>:<password>@<host>:5432/<database>"
      ]
    },
    "mysql": {
      "command": "npx",
      "args": [
        "-y",
        "@benborber/mcp-server-mysql",
        "mysql://<user>:<password>@<host>:3306/<database>"
      ]
    }
  }
}
